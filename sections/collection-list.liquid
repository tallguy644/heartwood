<section class="section{% if section.settings.alt_background %} color-alt{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header"><div><h2>{{ section.settings.heading | escape }}</h2></div></div>
    {%- endif -%}
    <div class="collection-tiles">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <a class="collection-tile" href="{% if c != blank %}{{ c.url }}{% else %}{{ routes.collections_url }}{% endif %}" {{ block.shopify_attributes }}>
          <div class="collection-tile__media">
            {%- if c.featured_image -%}
              {{ c.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 100vw', widths: '450, 650, 900', alt: c.title }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <span class="collection-tile__title">{% if c != blank %}{{ c.title | escape }}{% else %}Collection{% endif %}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "checkbox", "id": "alt_background", "label": "Use alternate background", "default": true }
  ],
  "blocks": [
    { "type": "collection", "name": "Collection", "settings": [ { "type": "collection", "id": "collection", "label": "Collection" } ] }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "Collection list", "blocks": [ { "type": "collection" }, { "type": "collection" }, { "type": "collection" } ] }
  ]
}
{% endschema %}
