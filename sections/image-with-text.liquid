<section class="section{% if section.settings.alt_background %} color-alt{% endif %}">
  <div class="page-width image-with-text{% if section.settings.image_right %} image-with-text--reverse{% endif %}">
    <div class="image-with-text__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag:
          loading: 'lazy',
          sizes: '(min-width: 750px) 50vw, 100vw',
          widths: '550, 750, 1100, 1400'
        }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="image-with-text__content">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="button button--outline">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "image_right", "label": "Image on the right", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "Meet the maker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sawdust, patience and a lot of coffee" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell your story here — how you got started, what you love to build, and what makes your work different. Customers buy handmade from people, so let them meet you.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Our story" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "alt_background", "label": "Use alternate background", "default": false }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
