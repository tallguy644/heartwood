<section class="password color-dark">
  <img src="{{ 'live-edge-shelves.jpg' | asset_url }}" class="password__bg" alt="" width="1272" height="1230">
  <div class="password__inner">
    <h1>{{ shop.name }}</h1>
    <p>{{ section.settings.text | escape }}</p>

    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success">You're on the list — we'll email you when we open.</p>
      {%- else -%}
        <div class="newsletter-form__row">
          <label for="PwEmail" class="visually-hidden">Email</label>
          <input id="PwEmail" type="email" name="contact[email]" placeholder="Email address" required>
          <button type="submit" class="button">Notify me</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary>Store owner? Enter password</summary>
      {%- form 'storefront_password' -%}
        {{ form.errors | default_errors }}
        <div class="newsletter-form__row">
          <label for="Password" class="visually-hidden">Password</label>
          <input id="Password" type="password" name="password" autocomplete="current-password" placeholder="Password">
          <button type="submit" class="button button--outline">Enter</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "text", "label": "Message", "default": "The shop is getting its finishing coat. Sign up to hear when we open." }
  ]
}
{% endschema %}
