<section class="section">
  <div class="page-width">
    <header class="page-header"><h1>{{ section.settings.heading | escape }}</h1></header>
    <div class="collection-tiles">
      {%- for collection in collections -%}
        <a class="collection-tile" href="{{ collection.url }}">
          <div class="collection-tile__media">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 100vw', widths: '450, 650, 900', alt: collection.title }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <span class="collection-tile__title">{{ collection.title | escape }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" }
  ]
}
{% endschema %}
